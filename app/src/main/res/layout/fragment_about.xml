<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/about"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical"
    android:padding="16dp">


        <!-- Title -->
    <TextView
        android:id="@+id/about_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="About the App"
        android:textColor="@color/yellow"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_gravity="center|top"
        android:layout_marginTop="6dp"
        android:layout_marginStart="6dp"/>

    <ImageView
        android:id="@+id/berlin_girl"
        android:layout_width="wrap_content"
        android:layout_height="250dp"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:contentDescription="Illustration"
        android:src="@drawable/berlin_girl" />

    <!-- Welcome Text below Image (Below the Team Photo) -->
    <TextView
        android:id="@+id/about_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Welcome to BrightTrip, your trusted companion for safe night commutes!"
        android:textColor="@color/yellow"
        android:textStyle="bold"
        android:textSize="22sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginTop="8dp"/>

    <!-- More Info Text (Further Details) below the Welcome Text -->
    <TextView
        android:id="@+id/about_more_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/app_text"
        android:text="This app was created by Pia Wolffram and Tanya Pozdnyakova. Driven by a shared passion for enhancing community safety, we aimed to design a user-friendly app that can help you commute confidently during late-night hours. Whether you're a resident or a visitor, BrightTrip is here to ensure you feel secure and informed every step of the way."
        android:textSize="16sp"
        android:lineSpacingExtra="6dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/stay_safe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/app_text"
        android:text="Stay safe!"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:textSize="22sp"
        android:lineSpacingExtra="6dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" />

    <!-- Heart Icon centered horizontally below the Text Content -->
    <ImageView
        android:id="@+id/heart_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center"
        android:contentDescription="Heart icon"
        android:src="@drawable/heart" />

</LinearLayout>